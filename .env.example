# Copia este archivo como .env (NO se sube a GitHub) y ajusta los valores.
# En Azure estas variables se configuran en App Service > Settings > Environment variables.

# Base de datos. En Azure la URL tiene este formato:
# jdbc:postgresql://<servidor>.postgres.database.azure.com:5432/<bd>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/reportes
DB_USER=reportes
DB_PASSWORD=reportes

# true = carga reportes de ejemplo si la tabla está vacía
SEED_DATA=false

# Módulo de fotos (lo configura A). Nunca subir valores reales al repositorio.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=fotos
